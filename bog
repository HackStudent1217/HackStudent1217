#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os, json, subprocess, shutil, threading, queue, sqlite3, socket
from datetime import datetime
from pathlib import Path
from flask import Flask, Response, request, jsonify, send_from_directory, g

APP_PORT = int(os.getenv("PORT", "8000"))
OUTDIR = Path(os.getenv("OUT", "./out"))
DB_PATH = OUTDIR / "reconx.db"
OUTDIR.mkdir(parents=True, exist_ok=True)

app = Flask(__name__)
event_q = queue.Queue()
scan_threads = {}
stop_flags = {}

# ---------- Database ----------
def get_db():
    db = getattr(g, "_db", None)
    if db is None:
        db = sqlite3.connect(DB_PATH)
        db.row_factory = sqlite3.Row
        g._db = db
    return db

@app.teardown_appcontext
def close_db(exception):
    db = getattr(g, "_db", None)
    if db is not None:
        db.close()

def init_db():
    db = get_db()
    db.executescript("""
    CREATE TABLE IF NOT EXISTS scans (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        domain TEXT, started TEXT, finished TEXT, status TEXT
    );
    CREATE TABLE IF NOT EXISTS findings (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        scan_id INTEGER, type TEXT, value TEXT,
        FOREIGN KEY(scan_id) REFERENCES scans(id)
    );
    """)
    db.commit()

# ---------- Utils ----------
def emit(event_type, data):
    event_q.put({"type": event_type, "data": data, "ts": datetime.utcnow().isoformat() + "Z"})

def tool_exists(name: str) -> bool:
    return shutil.which(name) is not None

def run_cmd(cmd, input_data=None):
    try:
        p = subprocess.run(cmd,
                           input=(input_data.encode() if isinstance(input_data, str) else None),
                           capture_output=True, text=True, check=False)
        return p.stdout.strip()
    except Exception as e:
        return f"ERROR: {e}"

# ---------- Recon Pipeline ----------
def recon_live(scan_id: int, domain: str):
    db = get_db()
    stop_flags[scan_id] = False
    emit("status", f"شروع اسکن {domain} (ID {scan_id})")

    def save_finding(ftype, val):
        db.execute("INSERT INTO findings(scan_id,type,value) VALUES(?,?,?)", (scan_id, ftype, val))
        db.commit()

    subs, urls = set(), set()

    # Subfinder
    if tool_exists("subfinder"):
        emit("status", "در حال اجرا: subfinder")
        out = run_cmd(["subfinder", "-silent", "-d", domain])
        subs |= {l for l in out.splitlines() if l.strip()}

    # Amass (backup)
    if not subs and tool_exists("amass"):
        emit("status", "در حال اجرا: amass")
        out = run_cmd(["amass", "enum", "-passive", "-d", domain])
        subs |= {l.strip() for l in out.splitlines() if l.strip() and domain in l}

    # Resolve IPs
    for s in subs:
        save_finding("subdomain", s)
        emit("subdomain", s)
        try:
            ip = socket.gethostbyname(s)
            save_finding("ip", ip)
            emit("ip", f"{s} -> {ip}")
        except:
            pass
        if stop_flags[scan_id]: break

    # httpx
    if subs and tool_exists("httpx"):
        emit("status", "در حال اجرا: httpx")
        out = run_cmd(["httpx", "-silent"], input_data="\n".join(subs))
        for u in out.splitlines():
            if u.startswith("http"):
                urls.add(u)
                save_finding("url", u)
                emit("url", u)
            if stop_flags[scan_id]: break

    # masscan
    if tool_exists("masscan"):
        emit("status", "در حال اجرا: masscan")
        out = run_cmd(["masscan", domain, "-p1-1000", "--rate", "1000", "--wait", "3"])
        for ln in out.splitlines():
            if "Discovered open port" in ln:
                parts = ln.split()
                port = parts[3]  # مثلا "80/tcp"
                ip = parts[-1]   # مثلا "1.2.3.4"
                save_finding("ip", ip)
                save_finding("port", f"{ip}:{port}")
                emit("port", f"{ip}:{port}")

    # nuclei
    if urls and tool_exists("nuclei"):
        emit("status", "در حال اجرا: nuclei")
        out = run_cmd(["nuclei", "-silent"], input_data="\n".join(urls))
        for v in out.splitlines():
            save_finding("vuln", v)
            emit("vuln", v)

    # پایان
    db.execute("UPDATE scans SET finished=?, status=? WHERE id=?",
               (datetime.utcnow().isoformat(), "done", scan_id))
    db.commit()
    emit("done", f"اسکن {domain} (ID {scan_id}) تمام شد")

# ---------- Flask Routes ----------
@app.get("/")
def index():
    return send_from_directory("static", "index.html")

@app.get("/events")
def sse_events():
    def gen():
        while True:
            msg = event_q.get()
            yield f"data: {json.dumps(msg, ensure_ascii=False)}\n\n"
    return Response(gen(), mimetype="text/event-stream")

@app.post("/start")
def start_scan():
    domain = request.json.get("domain")
    if not domain:
        return jsonify({"ok": False, "error": "domain required"}), 400
    db = get_db()
    cur = db.execute("INSERT INTO scans(domain,started,status) VALUES(?,?,?)",
                     (domain, datetime.utcnow().isoformat(), "running"))
    scan_id = cur.lastrowid
    db.commit()
    t = threading.Thread(target=recon_live, args=(scan_id, domain), daemon=True)
    scan_threads[scan_id] = t
    t.start()
    return jsonify({"ok": True, "scan_id": scan_id})

@app.post("/stop")
def stop_scan():
    scan_id = request.json.get("scan_id")
    if scan_id not in stop_flags:
        return jsonify({"ok": False, "error": "scan_id not found"}), 404
    stop_flags[scan_id] = True
    return jsonify({"ok": True, "message": f"Scan {scan_id} stopping..."})

@app.get("/history")
def history():
    db = get_db()
    scans = db.execute("SELECT * FROM scans ORDER BY id DESC").fetchall()
    return jsonify([dict(s) for s in scans])

@app.get("/findings/<int:scan_id>")
def findings(scan_id):
    db = get_db()
    rows = db.execute("SELECT type,value FROM findings WHERE scan_id=?", (scan_id,)).fetchall()
    return jsonify([dict(r) for r in rows])

# ---------- Main ----------
if __name__ == "__main__":
    init_db()
    app.run(host="0.0.0.0", port=APP_PORT, debug=False, threaded=True)







<!doctype html>
<html lang="fa">
<head>
<meta charset="utf-8"/>
<title>ReconX Live Dashboard</title>
<script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
<style>
body { font-family: Arial, sans-serif; background:#0b1220; color:#eee; margin:0; }
.container { max-width:1000px; margin:30px auto; padding:20px; }
.card { background:#111a2b; border-radius:12px; padding:16px; margin-bottom:20px; }
input, button { padding:6px 10px; margin:4px; }
#log { white-space:pre-wrap; background:#000; padding:8px; height:200px; overflow-y:scroll; }
#network { height:500px; border:1px solid #333; margin-top:20px; background:#fff; }
</style>
</head>
<body>
<div class="container">
  <h1>ReconX Live Dashboard</h1>

  <div class="card">
    <input type="text" id="domain" placeholder="example.com"/>
    <button onclick="startScan()">Start</button>
    <input type="number" id="scanIdStop" placeholder="Scan ID"/>
    <button onclick="stopScan()">Stop</button>
  </div>

  <div class="card">
    <h2>Live Log</h2>
    <div id="log"></div>
  </div>

  <div class="card">
    <h2>History</h2>
    <ul id="history"></ul>
  </div>

  <div class="card">
    <h2>Findings (Filtered)</h2>
    <input type="text" id="filter" placeholder="جست‌وجو..." oninput="filterFindings()"/>
    <ul id="findings"></ul>
  </div>

  <div class="card">
    <h2>Network Graph</h2>
    <div id="network"></div>
  </div>
</div>

<script>
const logDiv=document.getElementById("log");
const histUl=document.getElementById("history");
const findUl=document.getElementById("findings");
let findings=[];

function appendLog(msg){ logDiv.textContent+=msg+"\n"; logDiv.scrollTop=logDiv.scrollHeight; }

const es=new EventSource("/events");
es.onmessage=(e)=>{
  const o=JSON.parse(e.data);
  appendLog(`[${o.type}] ${o.data}`);
};

function startScan(){
  const domain=document.getElementById("domain").value;
  fetch("/start",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({domain})})
    .then(r=>r.json()).then(j=>{appendLog("Started scan ID "+j.scan_id);loadHistory();});
}
function stopScan(){
  const scan_id=document.getElementById("scanIdStop").value;
  fetch("/stop",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({scan_id:parseInt(scan_id)})})
    .then(r=>r.json()).then(j=>appendLog("Stop: "+JSON.stringify(j)));
}
function loadHistory(){
  fetch("/history").then(r=>r.json()).then(arr=>{
    histUl.innerHTML="";
    arr.forEach(s=>{
      const li=document.createElement("li");
      li.textContent=`ID ${s.id} — ${s.domain} (${s.status})`;
      li.onclick=()=>loadFindings(s.id);
      histUl.appendChild(li);
    });
  });
}
function loadFindings(id){
  fetch("/findings/"+id).then(r=>r.json()).then(arr=>{
    findings=arr;
    renderFindings();
    renderGraph();
  });
}
function renderFindings(){
  const f=document.getElementById("filter").value.toLowerCase();
  findUl.innerHTML="";
  findings.filter(x=>x.value.toLowerCase().includes(f)).forEach(x=>{
    const li=document.createElement("li");
    li.textContent=`[${x.type}] ${x.value}`;
    findUl.appendChild(li);
  });
}
function filterFindings(){ renderFindings(); }

function renderGraph(){
  const nodes=[], edges=[], seen=new Set();
  findings.forEach((f,idx)=>{
    if(!seen.has(f.value)){
      let color="#ccc", shape="ellipse";
      if(f.type==="subdomain"){ color="#6fa8dc"; shape="ellipse"; }
      if(f.type==="ip"){ color="#93c47d"; shape="box"; }
      if(f.type==="port"){ color="#e06666"; shape="dot"; }
      nodes.push({id:f.value,label:f.value,shape:shape,color:color});
      seen.add(f.value);
    }
  });
  findings.forEach(f=>{
    if(f.type==="ip"){
      const sub=findings.find(x=>x.type==="subdomain" && f.value.includes(x.value.split(".")[0]));
      if(sub) edges.push({from:sub.value,to:f.value});
    }
  });
  findings.forEach(f=>{
    if(f.type==="port"){
      const [ip,prt]=f.value.split(":");
      if(ip) edges.push({from:ip,to:f.value});
    }
  });
  const container=document.getElementById("network");
  const data={nodes:new vis.DataSet(nodes),edges:new vis.DataSet(edges)};
  const options={physics:{stabilization:true},interaction:{hover:true},nodes:{font:{size:16}},edges:{arrows:"to"}};
  new vis.Network(container,data,options);
}

loadHistory();
</script>
</body>
</html>






FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3 python3-pip \
    subfinder amass dnsx httpx \
    masscan nmap nuclei ffuf hakrawler \
    curl ca-certificates git jq sqlite3 \
  && rm -rf /var/lib/apt/lists/*

RUN pip3 install flask

WORKDIR /app
COPY app.py /app/app.py
COPY static /app/static

RUN useradd -m -u 10001 appuser && mkdir -p /data && chown -R appuser:appuser /data /app
USER appuser
ENV OUT=/data PORT=8000
VOLUME ["/data"]
EXPOSE 8000

CMD ["python3","app.py"]








